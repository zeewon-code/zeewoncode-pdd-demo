<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.zeewoncode.pdd_server.mapper.SkuMapper">
    <insert id="insertBatch" parameterType="java.util.List" >
        INSERT INTO sku
        <foreach collection="activeFields" item="field" open="(" close=")" separator=",">
            ${field}
        </foreach>
        VALUES
        <trim suffixOverrides=",">
            <foreach collection="skuList" item="sku" separator=",">
                (
                <trim suffixOverrides=",">
                    <!-- 按 activeFields 的顺序逐个判断并输出，保证列值对齐 -->
                    <foreach collection="activeFields" item="field" separator=",">
                        <choose>
                            <when test="field == 'spu_id'">#{sku.spuId}</when>
                            <when test="field == 'specs'">#{sku.specs}</when>
                            <when test="field == 'price'">#{sku.price}</when>
                            <when test="field == 'stock'">#{sku.stock}</when>
                            <when test="field == 'image'">#{sku.image}</when>
                        </choose>
                    </foreach>
                </trim>
                )
            </foreach>
        </trim>
    </insert>


    <update id="lockStock">
        UPDATE sku
        SET locked_stock = CASE id
            <foreach collection="items" item="item">
                WHEN #{item.skuId} THEN locked_stock + #{item.quantity}
            </foreach>
        END
        WHERE id IN
            <foreach collection="items" item="item" separator="," open="(" close=")">
                #{item.skuId}
            </foreach>
        AND deleted_flag = 0
        AND status = 1
        AND (stock - locked_stock) >= CASE id
            <foreach collection="items" item="item">
                WHEN #{item.skuId} THEN #{item.quantity}
            </foreach>
        END
    </update>

    <select id="selectSkuMinPriceAndMaxPriceBySpuIds" resultType="com.zeewoncode.entity.SpuCard">
        SELECT spu_id as id, MIN(price) as minPrice, MAX(price) as maxPrice
        FROM sku
        WHERE spu_id IN
            <foreach collection="spuIds" item="spuId" separator="," open="(" close=")">
                #{spuId}
            </foreach>
        AND deleted_flag = 0
        GROUP BY spu_id
    </select>
    <select id="selectLowStockSkus" resultType="com.zeewoncode.vo.LowStockSkus">
        SELECT sk.id, sk.spu_id, sp.title, sk.specs, sk.stock
        FROM sku sk LEFT JOIN spu sp ON sk.spu_id = sp.id
        WHERE sk.spu_id IN
            <foreach collection="spuIds" item="spuId" separator="," open="(" close=")">
                #{spuId}
            </foreach>
        AND sk.deleted_flag = 0
        AND sk.status = 1
        AND sk.stock &lt;= 10
    </select>

    <update id="update" parameterType="com.zeewoncode.entity.Sku">
        UPDATE sku
        <set>
            <if test="specs != null and specs != ''">specs = #{specs},</if>
            <if test="price != null">price = #{price},</if>
            <if test="stock != null">stock = #{stock},</if>
            <if test="image != null and image != ''">image = #{image},</if>
            <if test="status != null">status = #{status},</if>
            <if test="deletedFlag != null">deleted_flag = #{deletedFlag},</if>
            <if test="stock != null">stock = #{stock},</if>
            <if test="lockedStock != null">locked_stock = #{lockedStock},</if>
        </set>
        WHERE id = #{id}
    </update>
</mapper>
