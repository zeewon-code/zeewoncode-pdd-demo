<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.zeewoncode.pdd_server.mapper.CartMapper">


    <update id="updateCartItem" parameterType="com.zeewoncode.entity.CartItem">
        update cart_item
        <set>
            <if test="cartItem.quantity != null">
                quantity = #{quantity},
            </if>
            <if test="cartItem.selected != null">
                selected = #{selected},
            </if>
            <if test="cartItem.updatedAt != null">
                updated_at = #{updatedAt},
            </if>
        </set>
        where sku_id = #{skuId} AND user_id = #{userId}
    </update>
    <update id="updateCartSelectByIds">
        update cart_item
        <set>
            selected = #{selected}
        </set>
        where id in
        <foreach item="cartItemId" collection="cartItemIds" open="(" separator="," close=")">
            #{cartItemId}
        </foreach>
    </update>
    <delete id="deleteCartItemsByUserIdAndSkuIds">
        delete from cart_item
        where user_id = #{userId} and sku_id in
        <foreach item="skuId" collection="skuIds" open="(" separator="," close=")">
            #{skuId}
        </foreach>
    </delete>
</mapper>
