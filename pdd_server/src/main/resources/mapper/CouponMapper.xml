<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.zeewoncode.pdd_server.mapper.CouponMapper">



    <update id="updateUserCoupon">
        update user_coupon
        <set>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="orderId != null">
                order_id = #{orderId},
            </if>
            <if test="usedAt != null">
                used_at = #{usedAt},
            </if>
        </set>
        where id = #{id}
    </update>

    <select id="selectCouponsByValidTime" resultType="com.zeewoncode.vo.CouponVO">
        select id, title, condition_amount, discount_amount,
               discount_rate, valid_to, (total - issued) as remain
        from coupon
        where valid_to &gt; #{now}
    </select>
</mapper>
