<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.zeewoncode.pdd_server.mapper.MerchantMapper">


    <update id="update">
        UPDATE merchant
        <set>
            <if test="shopName != null">
                shop_name = #{shopName},
            </if>
            <if test="logo != null">
                logo = #{logo},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
        </set>
        WHERE user_id = #{userId}
        <if test="id != null">
            AND id = #{id}
        </if>
    </update>
</mapper>
